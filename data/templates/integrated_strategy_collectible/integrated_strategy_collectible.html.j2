<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ collectible.name | e }}</title>
  <style>
    @font-face {
      font-family: "Harmony";
      {% if template_font_url %}
      src: url("{{ template_font_url }}") format("truetype");
      {% else %}
      src: local("HarmonyOS Sans SC"), local("Noto Sans CJK SC"), sans-serif;
      {% endif %}
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; width: 1000px; min-height: 700px; background: #101518; color: #f5f1e7; }
    body { font-family: "Harmony", sans-serif; }
    #template {
      position: relative;
      width: 1000px;
      min-height: 700px;
      overflow: hidden;
      padding: 42px 48px 34px;
      background:
        linear-gradient(120deg, rgb(8 17 19 / 96%), rgb(25 33 32 / 94%)),
        repeating-linear-gradient(135deg, transparent 0 34px, rgb(205 177 111 / 5%) 34px 35px);
      border-top: 8px solid #cdb16f;
    }
    #template::before {
      content: "";
      position: absolute;
      inset: 18px;
      pointer-events: none;
      border: 1px solid rgb(205 177 111 / 25%);
    }
    #template::after {
      content: "RHODES ISLAND · INTEGRATED STRATEGIES";
      position: absolute;
      top: 18px;
      right: 34px;
      color: rgb(205 177 111 / 36%);
      font: 600 11px/1 "Harmony", sans-serif;
      letter-spacing: 2.4px;
    }
    .hero { position: relative; display: grid; grid-template-columns: 270px 1fr; gap: 38px; align-items: center; min-height: 292px; }
    .icon-frame {
      position: relative;
      display: grid;
      width: 270px;
      height: 270px;
      place-items: center;
      background: radial-gradient(circle, #3b403d 0, #202725 62%, #111716 100%);
      border: 2px solid #cdb16f;
      box-shadow: 0 15px 35px rgb(0 0 0 / 44%), inset 0 0 40px rgb(205 177 111 / 9%);
      clip-path: polygon(12% 0, 100% 0, 100% 88%, 88% 100%, 0 100%, 0 12%);
    }
    .icon-frame::before { content: ""; position: absolute; inset: 13px; border: 1px solid rgb(255 255 255 / 13%); }
    .icon-frame img { z-index: 1; width: 232px; height: 232px; object-fit: contain; filter: drop-shadow(0 9px 10px rgb(0 0 0 / 42%)); }
    .icon-fallback { color: #cdb16f; font-size: 92px; font-weight: 200; transform: rotate(45deg); }
    .meta { min-width: 0; }
    .eyebrow { color: #cdb16f; font-size: 15px; font-weight: 700; letter-spacing: 3px; }
    h1 { margin: 10px 0 8px; font-size: 48px; line-height: 1.12; letter-spacing: 1px; }
    .topic { color: #aeb7b2; font-size: 20px; }
    .badges { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 19px; }
    .badge { padding: 6px 13px; border: 1px solid #596460; color: #d9dfdc; background: rgb(255 255 255 / 4%); font-size: 15px; }
    .badge.rarity { border-color: #cdb16f; color: #181c1b; background: #cdb16f; font-weight: 800; }
    .effect { position: relative; margin-top: 28px; padding: 21px 24px 21px 30px; background: linear-gradient(90deg, rgb(205 177 111 / 19%), rgb(205 177 111 / 4%)); border-left: 5px solid #cdb16f; }
    .label { margin-bottom: 8px; color: #cdb16f; font-size: 13px; font-weight: 800; letter-spacing: 2px; }
    .effect-text { font-size: 25px; font-weight: 700; line-height: 1.5; }
    .description { margin: 22px 4px 0; color: #c7cfcb; font-size: 18px; font-style: italic; line-height: 1.65; }
    .details { display: grid; grid-template-columns: 1.25fr 1fr .72fr; gap: 12px; margin-top: 22px; }
    .detail { min-height: 91px; padding: 14px 16px; background: rgb(255 255 255 / 5%); border-top: 1px solid #58615e; }
    .detail-value { color: #edf0ee; font-size: 16px; line-height: 1.45; }
    .footer { display: flex; justify-content: space-between; gap: 20px; margin-top: 25px; color: #77817c; font-size: 12px; letter-spacing: .4px; }
    .footer .id { font-family: ui-monospace, "SFMono-Regular", Consolas, monospace; }
  </style>
</head>
<body>
<main id="template">
  <section class="hero">
    <div class="icon-frame">
      {% if icon_data %}
      <img src="{{ icon_data }}" alt="{{ collectible.name | e }}">
      {% else %}
      <span class="icon-fallback">◇</span>
      {% endif %}
    </div>
    <div class="meta">
      <div class="eyebrow">集成战略藏品</div>
      <h1>{{ collectible.name | e }}</h1>
      <div class="topic">{{ collectible.topic_name | e }}</div>
      <div class="badges">
        {% if collectible.rarity %}<span class="badge rarity">{{ collectible.rarity | e }}</span>{% endif %}
        <span class="badge">{{ "可被牺牲" if collectible.can_sacrifice else "不可被牺牲" }}</span>
      </div>
    </div>
  </section>

  <section class="effect">
    <div class="label">藏品效果</div>
    <div class="effect-text">{{ (collectible.usage or "暂无效果说明") | e }}</div>
  </section>

  {% if collectible.description %}
  <div class="description">「{{ collectible.description | e }}」</div>
  {% endif %}

  <section class="details">
    <div class="detail">
      <div class="label">解锁条件</div>
      <div class="detail-value">{{ (collectible.unlock_condition or "无特殊解锁条件") | e }}</div>
    </div>
    <div class="detail">
      <div class="label">获取方式</div>
      <div class="detail-value">{{ (collectible.obtain_approach or "集成战略模式内获得") | e }}</div>
    </div>
    <div class="detail">
      <div class="label">主题代号</div>
      <div class="detail-value">{{ collectible.topic_id | e }}</div>
    </div>
  </section>

  <footer class="footer">
    <span>数据来源：明日方舟本地解包资源</span>
    <span class="id">{{ collectible.id | e }}</span>
  </footer>
</main>
</body>
</html>
