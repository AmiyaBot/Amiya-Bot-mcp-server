<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8">
<title>{{ op.name }}</title><style>

:root{
  --ink:#24272c;
  --ink-soft:#3a4047;
  --muted:#70757d;
  --bg:#ecebe8;
  --pale:#f8f7f4;
  --line:#cfcfc9;
  --line-strong:#b6b7b1;
  --dark:#1d2024;
  --dark-2:#2c3137;
  --accent:#f08b2d;
  --accent-soft:#fff1df;
  --gold:#caa15a;
  --ok:#7aa57a;
}
*{box-sizing:border-box}
body{background:#1b1d21;color:var(--ink);font-family:'Noto Sans CJK SC','Microsoft Yahei',sans-serif;margin:0;padding:32px 0 60px}
.toolbar{max-width:1080px;display:flex;justify-content:space-between;gap:16px;margin:0 auto 20px;color:#d8dade;font-size:17px;padding:0 10px}
.preview{width:min(calc(100vw - 24px),1080px);margin:auto;box-shadow:0 20px 80px rgba(0,0,0,.45);overflow:hidden}
.poster{width:1080px;position:relative;transform-origin:top left;background:var(--bg);padding:36px;overflow:hidden}
.poster:before{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(135deg,rgba(255,255,255,.45) 0%,transparent 25%),repeating-linear-gradient(90deg,transparent 0 119px,rgba(0,0,0,.03) 120px),linear-gradient(180deg,rgba(240,139,45,.045),transparent 16%);opacity:.92}
.poster>*{position:relative}
.mast{display:flex;justify-content:space-between;align-items:center;border-bottom:4px solid var(--dark);height:100px;gap:16px;margin-bottom:22px}
.brand{display:flex;align-items:center;gap:16px}
.brand-symbol{width:68px;height:68px;border:4px solid var(--dark);font:700 42px/59px Georgia,serif;text-align:center;color:var(--dark)}
.brand-type b{font-size:29px;letter-spacing:4px;display:block;color:var(--dark)}
.brand-type span{color:var(--muted);font-size:16px;letter-spacing:2px}
.mast-r{text-align:right;font-weight:800;font-size:22px;letter-spacing:3px;color:var(--dark)}
.mast-r small{display:block;color:var(--muted);font-size:18px;letter-spacing:1px;margin-top:5px}
.hero{height:1120px;overflow:hidden;background:linear-gradient(136deg,#f1f0ed,#ddddda);border:2px solid var(--line-strong);margin-bottom:18px}
.hero:before{content:'';position:absolute;width:820px;height:820px;top:90px;right:-150px;border:2px solid rgba(240,139,45,.17);border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.55),rgba(255,255,255,0) 65%)}
.hero:after{content:'';position:absolute;z-index:2;left:0;top:0;bottom:0;width:53%;background:linear-gradient(90deg,rgba(241,240,237,.96) 0%,rgba(241,240,237,.9) 52%,rgba(241,240,237,0) 100%);pointer-events:none}
.hero-img{position:absolute;z-index:1;width:657px;height:1180px;object-fit:contain;right:2px;top:-16px;filter:drop-shadow(0 18px 8px rgba(0,0,0,.12))}
.hero-identity{position:absolute;z-index:3;left:40px;top:46px;width:450px}
.small-cap{font-size:20px;letter-spacing:3px;font-weight:800;color:var(--accent)}
.ew{font-size:30px;letter-spacing:4px;font-weight:900;color:#878b91;margin-top:10px}
.hero h1{font-family:'Noto Serif CJK SC',serif;font-weight:850;font-size:90px;letter-spacing:7px;line-height:1.2;margin:18px 0 18px;white-space:nowrap;color:var(--dark)}
.starline{color:var(--gold);font-size:38px;letter-spacing:4px;margin:13px 0}
.hero-flags{display:flex;gap:10px;flex-wrap:wrap;max-width:390px}
.hero-flags span{background:var(--dark-2);color:#fff;font-size:26px;font-weight:700;padding:8px 12px}
.hero-flags span.light{background:#ece7df;color:#4a4d52;border:1px solid #d3cdc3}
.identity-list{margin-top:38px;border-left:6px solid var(--accent);padding:8px 0 8px 23px;display:flex;flex-direction:column;gap:11px;width:390px}
.identity-list div{font-size:29px;line-height:1.35}.identity-list b{font-weight:550;color:#7b7f87;font-size:24px;margin-right:18px}
.hero-label{position:absolute;z-index:4;bottom:26px;left:30px;font-size:22px;color:#fff;background:rgba(29,32,36,.88);padding:11px 18px;letter-spacing:3px}
.section{margin:17px 0;background:var(--pale);border:2px solid var(--line);padding:25px 27px 27px}
.section-title{display:flex;align-items:center;gap:19px;border-bottom:3px solid var(--line);padding-bottom:15px;margin-bottom:22px}
.section-title h2{font-size:47px;letter-spacing:3px;margin:0;line-height:1.2;color:var(--dark)}
.section-title .num{color:var(--accent);font-size:21px;font-weight:900;letter-spacing:2px;margin-left:auto;white-space:nowrap}
.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px 10px}
.stat{min-height:110px;border-bottom:2px solid #e2e1dc;padding:2px 0 13px}
.stat label{font-size:26px;color:var(--muted);display:block;margin-bottom:3px}
.stat strong{font-size:50px;font-family:Arial,sans-serif;line-height:1.3;letter-spacing:-1px;color:var(--dark)}
.stat em{font-style:normal;font-size:26px;color:#d67e27;font-weight:850;margin-left:5px}
.stat em.orange{color:#f0a53b}
.read{font-size:41px;line-height:1.58;margin:0;color:var(--ink-soft);overflow-wrap:anywhere}
.read small{font-size:33px}
.talent,.base-entry{padding:8px 0 24px;border-bottom:2px solid #dfdfd9;margin-bottom:18px}
.talent:last-child,.base-entry:last-child{padding-bottom:0;border-bottom:0;margin-bottom:0}
.tal-title{font-weight:900;color:var(--dark);font-size:40px;margin-bottom:10px;display:flex;align-items:baseline;gap:16px;flex-wrap:wrap}
.tal-title .rank{font-size:24px;color:#6a6f75;background:#f1eee7;border:1px solid #d6d0c6;padding:4px 10px}
.skill{padding:22px 16px 26px;background:#fbfaf7;border:2px solid #d4d1ca;border-left:9px solid var(--accent);margin-bottom:18px}
.skill:last-child{margin-bottom:0}
.skill-top{display:flex;align-items:center;gap:20px;margin-bottom:16px}
.skill-img{width:118px;height:118px;object-fit:cover;border:2px solid #bbb7ae;flex:none}
.skill-ttl{min-width:0}
.skill-ttl h3{font-size:44px;margin:0 0 11px;line-height:1.25;color:var(--dark)}
.skill-type{display:flex;flex-wrap:wrap;gap:9px}
.skill-type span{font-size:27px;padding:5px 13px;background:#f3ede4;color:#575b60;border:1px solid #ddd4c6;line-height:1.3}
.skill-metrics{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:14px}
.skill-metrics span{font-size:30px;font-weight:800;color:#4b4f55;background:var(--accent-soft);border-radius:4px;padding:6px 14px;border:1px solid #f4d1aa}
.skill .read{font-size:39px;line-height:1.6}
.split{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.pill{font-size:31px;line-height:1.4;background:#f2f1ed;padding:12px 15px;font-weight:650;border-left:5px solid var(--accent)}
.pill:before{content:'✦ ';color:var(--accent)}
.module{display:flex;gap:24px;align-items:start}
.module-icon{height:120px;width:120px;object-fit:contain;background:var(--dark);flex:none}
.module-info{flex:1}
.module-info h3{font-size:40px;margin:0 0 8px;color:var(--dark)}
.module .meta{font-size:29px;color:#62676d;font-weight:750;margin-bottom:16px}
.profiles{display:grid;grid-template-columns:1fr 1fr;gap:12px 26px;font-size:33px}
.profiles span{border-bottom:1px solid #deddd7;padding-bottom:10px}
.profiles b{display:block;color:#7b7f86;font-size:24px;margin-bottom:4px}
.quote{font-family:'Noto Serif CJK SC',serif;font-size:37px;line-height:1.6;color:#44484f;margin-top:14px}
.footer{padding:24px 4px 2px;display:flex;gap:20px;justify-content:space-between;color:#6f747c;font-size:22px;border-top:3px solid #c8c6bf;margin-top:25px;letter-spacing:2px}
@media(max-width:1120px){body{padding-top:12px}.toolbar{width:min(100%,800px);font-size:11px}}
@media print{body{margin:0;padding:0;background:#fff}.toolbar{display:none}.preview{width:1080px;box-shadow:none}.poster{transform:none!important}}

@font-face{font-family:Harmony;src:url("{{ template_font_url }}") format("truetype")}
body{margin:0;padding:0;background:var(--bg);font-family:Harmony,sans-serif;width:1080px}
.poster{margin:0}.hero h1{white-space:normal;overflow-wrap:anywhere;font-size:75px;letter-spacing:3px}
.hero-identity{width:480px}.ew{overflow-wrap:anywhere}.hero-img{width:720px;right:-40px}
.mast-r{font-size:21px}.identity-list{width:420px}.read{white-space:pre-line}
.stat strong{font-size:45px}.stat em{display:inline-block;font-size:22px}.stat{overflow-wrap:anywhere}
.note{font-size:24px;color:var(--muted);margin:12px 0 20px}.range{margin:18px 0}.block-group{display:flex;gap:4px;margin:4px 0}.block{width:24px;height:24px}.block.r{border:2px solid var(--ink)}.block.s{background:var(--accent)}
.bonds{display:flex;gap:20px;flex-wrap:wrap;margin-bottom:16px}.bond{display:flex;align-items:center;gap:10px;font-size:29px}.bond img{width:52px;height:52px;object-fit:contain}
.skill-ttl,.module-info{min-width:0;overflow-wrap:anywhere}.profiles span{overflow-wrap:anywhere}.chess-variant{margin-top:18px}.hero-label{letter-spacing:1px}
.skill-header{display:flex;align-items:center;gap:24px;margin-bottom:18px}
.skill-summary{flex:1;min-width:0}.skill-summary .skill-metrics{margin-bottom:0}
.skill-range{flex:none;margin-left:auto}.skill-range .range{margin:0}
.potential-list{display:flex;flex-direction:column;gap:12px}
.potential-row{display:flex;align-items:baseline;gap:24px;font-size:31px;line-height:1.4;background:#f2f1ed;padding:12px 15px;border-left:5px solid var(--accent)}
.potential-rank{flex:none;font-weight:800;color:var(--muted)}
.bond img{background:var(--dark-2);border-radius:6px;padding:7px}
.chess-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:20px}
.chess-heading .tal-title{margin:0}.chess-price{font-size:29px;white-space:nowrap;background:var(--accent-soft);padding:8px 16px;border:1px solid #f4d1aa}
.chess-condition{display:inline-block;font-size:27px;font-weight:700;background:var(--dark-2);color:white;padding:3px 12px;margin-right:12px;vertical-align:middle}
</style></head><body><main class="poster" id="template">
{% autoescape true %}
{% macro section(title, label) %}<div class="section-title"><h2>{{ title }}</h2><span class="num">{{ label }}</span></div>{% endmacro %}
{% macro range_blocks(text) %}{% if text %}<div class="range" aria-label="攻击范围">{% for line in text.splitlines() %}<div class="block-group">{% for char in line %}<div class="block {{ 'r' if char == '□' else 's' if char == '■' else '' }}"></div>{% endfor %}</div>{% endfor %}</div>{% endif %}{% endmacro %}
<header class="mast"><div class="brand"><div class="brand-symbol">R</div><div class="brand-type"><b>RHODES ISLAND</b><span>OPERATOR ARCHIVE</span></div></div><div class="mast-r">罗德岛 · 干员档案<small>RHODES ISLAND / RECORDS</small></div></header>
<section class="hero">
{% if skin_url %}<img class="hero-img" src="{{ skin_url }}" alt="{{ op.name }}立绘">{% endif %}
<div class="hero-identity"><div class="small-cap">{{ op.number or 'OPERATOR' }}</div><div class="ew">{{ op.en_name or '' }}</div><h1>{{ op.name }}</h1><div class="starline">{{ '★' * (op.rarity or 0) }}</div>
<div class="hero-flags"><span>{{ op.classes or '未知' }} · {{ op.classes_sub or '未知' }}</span>{% if op.is_sp %}<span>异格干员</span>{% endif %}{% for tag in op.tags or [] %}<span class="light">{{ tag }}</span>{% endfor %}</div>
<div class="identity-list">{% for label,value in [('势力',op.nation),('阵营',op.group),('种族',op.race),('队伍',op.team),('生日',op.birthday),('画师',op.drawer)] %}<div><b>{{ label }}</b>{{ value or '未知' }}</div>{% endfor %}</div></div><div class="hero-label">RHODES ISLAND · 人事档案</div></section>
<section class="section">{{ section('基础属性','PARAMETERS') }}<p class="note">最高精英阶段满级基础值；加成分别标注信赖、模组</p><div class="stats">
{% for key,label,unit in [('maxHp','最大生命值',''),('atk','攻击力',''),('def','防御力',''),('magicResistance','法术抗性',''),('attackSpeed','攻击速度',''),('baseAttackTime','攻击间隔','秒'),('blockCnt','阻挡数',''),('cost','部署费用',''),('respawnTime','再部署时间','秒')] %}
<div class="stat"><label>{{ label }}</label><strong>{{ base_attr.get(key,0) }}</strong>{% if unit %}<em>{{ unit }}</em>{% endif %}{% for source,attrs in [('信赖',trust_attr),('模组',module_attr)] %}{% set value=attrs.get(key,0) %}{% if value %}<em>{{ source }} {{ '+' if value > 0 else '' }}{{ value }}</em>{% endif %}{% endfor %}</div>{% endfor %}</div>{% if op.range %}<p class="note">攻击范围</p>{{ range_blocks(op.range) }}{% endif %}</section>
{% if op.operator_trait %}<section class="section">{{ section('职业特性','TRAIT') }}<div class="read">{{ op.operator_trait | safe }}</div></section>{% endif %}
{% if talents_list %}<section class="section">{{ section('天赋','TALENTS') }}{% for item in talents_list %}<div class="talent"><div class="tal-title">{{ item.talents_name }}</div><div class="read">{{ item.talents_desc | safe }}</div></div>{% endfor %}</section>{% endif %}
{% if op.skills %}<section class="section">{{ section('战斗技能','COMBAT SKILLS') }}{% for sk in op.skills %}{% set last=sk.levels[-1] if sk.levels else none %}{% if last %}
<article class="skill"><div class="skill-header"><div class="skill-summary"><div class="skill-top">{% set icon=skill_icon_data.get(sk.icon or '') %}{% if icon %}<img class="skill-img" src="{{ icon }}" alt="技能图标">{% endif %}<div class="skill-ttl"><h3>{{ sk.name }}</h3><div class="skill-type"><span>{{ {8:'专精一',9:'专精二',10:'专精三'}.get(last.level, (last.level|string) ~ '级') }}</span>{% if last.sp %}<span>{{ sp_type_name.get(last.sp.sp_type,last.sp.sp_type) }}</span>{% endif %}<span>{{ skill_type_name.get(last.skill_type,last.skill_type) }}</span></div></div></div>
<div class="skill-metrics">{% if last.sp %}<span>初始技力 {{ last.sp.init_sp }}</span><span>消耗技力 {{ last.sp.sp_cost }}</span>{% endif %}{% if last.duration and last.duration > 0 %}<span>持续 {{ last.duration }} 秒</span>{% endif %}</div></div>{% if last.range %}<div class="skill-range">{{ range_blocks(last.range) }}</div>{% endif %}</div><div class="read">{{ (last.description or '') | safe }}</div></article>{% endif %}{% endfor %}</section>{% endif %}
{% if building_skills %}<section class="section">{{ section('基建技能','BASE SKILLS') }}{% for item in building_skills %}<div class="base-entry"><div class="tal-title">{{ item.bs_name }}<span class="rank">精英 {{ item.bs_unlocked }}</span></div><div class="read">{{ item.bs_desc }}</div></div>{% endfor %}</section>{% endif %}
{% if potential_list %}<section class="section">{{ section('潜能提升','POTENTIAL') }}<div class="potential-list">{% for item in potential_list %}<div class="potential-row"><span class="potential-rank">潜能 {{ item.potential_rank + 2 }}</span><span>{{ item.potential_desc }}</span></div>{% endfor %}</div></section>{% endif %}
{% if autochess %}<section class="section">{{ section(autochess.title,'AUTOCHESS') }}<div class="bonds">{% for bond in autochess.bonds %}<div class="bond">{% if bond.icon %}<img src="{{ bond.icon }}" alt="">{% endif %}{{ bond.name }}</div>{% endfor %}</div><div class="chess-heading"><div class="tal-title">棋子等阶 {{ {1:'I',2:'II',3:'III',4:'IV',5:'V',6:'VI'}.get(autochess.tier,autochess.tier) }}</div><div class="chess-price">价格 {% for price in autochess.variants | map(attribute="price") | unique %}{{ price if price is not none else "—" }}{% if not loop.last %} / {% endif %}{% endfor %}</div></div>{% for variant in autochess.variants %}<div class="chess-variant"><div class="tal-title">{{ variant.name }}</div><div class="read">{% set desc = variant.description %}{% if desc.startswith('<') and '>' in desc %}{% set parts = desc.split('>', 1) %}<span class="chess-condition">{{ parts[0][1:] }}</span>{{ parts[1] }}{% else %}{{ desc }}{% endif %}</div></div>{% endfor %}</section>{% endif %}
<section class="section">{{ section('干员档案','PROFILE') }}<div class="profiles"><span><b>真名</b>{{ op.origin_names|join('、') if op.origin_names else op.origin_name or '未知' }}</span>{% for lang,names in (op.cv or {}).items() %}<span><b>{{ lang }}配音</b>{{ names if names is string else names|join('、') }}</span>{% endfor %}</div></section>
{% if op.profile or op.impression %}<section class="section">{{ section('干员印象','IMPRESSION') }}{% if op.profile %}<div class="read">{{ op.profile }}</div>{% endif %}{% if op.impression %}<div class="quote">「{{ op.impression }}」</div>{% endif %}</section>{% endif %}
{% if op.potential_item %}<section class="section">{{ section('信物','TOKEN') }}<div class="read">{{ op.potential_item }}</div></section>{% endif %}
<footer class="footer"><span>RHODES ISLAND</span><span>罗德岛 · 干员档案</span></footer>
{% endautoescape %}</main></body></html>
