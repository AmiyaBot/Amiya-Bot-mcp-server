<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8"><style>
@font-face{font-family:card;src:url('{{ template_font_url }}')}
*{box-sizing:border-box}body{margin:0;width:1080px;background:#10272c;color:#eaf5f2;font-family:card,'Noto Sans CJK SC',sans-serif}
main{padding:42px;background:radial-gradient(ellipse at top right,#24484b,transparent 65%);border-top:7px solid #8bd2c2}
header{display:flex;align-items:center;gap:28px;border-bottom:1px solid #5a817c;padding-bottom:28px}.emblem{width:132px;height:132px;border:1px solid #719f94;background:#17383c;display:grid;place-items:center}.emblem img{width:100px;height:100px;object-fit:contain}
.activity{font-size:30px;color:#9ac9c0;letter-spacing:2px}h1{font-size:56px;margin:6px 0}.kind{margin-left:auto;align-self:flex-start;color:#a5cdc5;border:1px solid #5a817c;padding:8px 18px;font-size:26px}
h2{font-size:30px;color:#a6d8cc;margin:28px 0 16px;letter-spacing:2px}.activation{padding:12px 18px;border-left:4px solid #d8ba70;background:#253d3c;color:#edce88;font-size:28px;margin-bottom:18px}
.effect{white-space:pre-wrap;font-size:30px;line-height:1.65}.members-title{display:flex;align-items:center;gap:16px}.count{font-size:22px;letter-spacing:0;color:#a0bcb6}
.grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:20px 18px}.member{background:#1c363a;border:1px solid #46635f;padding:9px;text-align:center}.portrait{position:relative;aspect-ratio:1;background:#304548}.portrait img{width:100%;height:100%;object-fit:cover}.tier{position:absolute;top:0;right:0;display:flex;align-items:center;gap:4px;background:#132c30ed;color:#edca79;padding:4px 7px;font-size:19px}.tier svg{width:22px;height:25px}.name{font-size:26px;margin-top:9px;overflow-wrap:anywhere}.empty{font-size:26px;color:#b4c7c2}
footer{border-top:1px solid #46635f;margin-top:32px;padding-top:16px;font-size:22px;color:#8aaea5;letter-spacing:2px}
.roman{font-family:Georgia,serif;font-size:27px;font-weight:bold;line-height:30px;min-width:30px;text-align:center}
</style></head><body><main>
<header><div class="emblem">{% if icon %}<img src="{{ icon }}">{% endif %}</div><div><div class="activity">{{ detail['卫戍协议']|e }}</div><h1>{{ detail['名称']|e }}</h1></div><div class="kind">盟约</div></header>
<h2>盟约效果</h2>{% if detail['激活条件'] %}<div class="activation">激活 · {{ detail['激活条件']|e }}</div>{% endif %}<div class="effect">{{ detail['效果']|e }}</div>
<h2 class="members-title">所属棋子 <span class="count">{{ members|length }} 位</span></h2><div class="grid">
{% for member in members %}<div class="member"><div class="portrait">{% if member.avatar %}<img src="{{ member.avatar }}">{% else %}<span class="empty">暂无头像</span>{% endif %}<div class="tier"><span class="roman" role="img" aria-label="棋子{{ member['等阶'] }}阶">{{ {1:'I',2:'II',3:'III',4:'IV',5:'V',6:'VI'}.get(member['等阶'], member['等阶']) }}</span></div></div><div class="name">{{ member['名称']|e }}</div></div>{% endfor %}
</div><footer>卫戍协议 · 盟约资料</footer></main></body></html>

