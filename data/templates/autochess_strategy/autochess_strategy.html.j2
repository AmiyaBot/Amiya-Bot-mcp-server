<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8"><style>
@font-face{font-family:card;src:url('{{ template_font_url }}')}
*{box-sizing:border-box}body{margin:0;width:1080px;background:#10272c;color:#eaf5f2;font-family:card,'Noto Sans CJK SC',sans-serif}main{padding:42px;background:radial-gradient(ellipse at top right,#294b4d,transparent 65%);border-top:7px solid #d5b980}
header{display:flex;align-items:center;gap:28px;border-bottom:1px solid #5a817c;padding-bottom:28px}.portrait{width:170px;height:170px;flex:none;background:#19373b;border:1px solid #70998e;display:grid;place-items:center}.portrait img{width:100%;height:100%;object-fit:contain}.activity{font-size:28px;color:#9ac9c0;letter-spacing:2px}h1{font-size:48px;margin:10px 0;overflow-wrap:anywhere}.owner{color:#d5ba80;font-size:30px}.kind{margin-left:auto;align-self:flex-start;white-space:nowrap;color:#dec897;border:1px solid #8e8567;padding:8px 18px;font-size:26px}
h2{font-size:30px;color:#aad5c9;margin:0 0 16px;letter-spacing:2px}.section{margin-top:24px;padding:24px;background:#ffffff07;border:1px solid #46635f}.text{white-space:pre-wrap;font-size:30px;line-height:1.65;overflow-wrap:anywhere}.skill-head{display:flex;align-items:center;gap:18px;margin-bottom:16px}.tag{background:#396f65;color:#e5fff4;padding:5px 16px;font-size:28px}.active{background:#8b7145;color:#fff1cf}.meta{color:#e2c78c;font-size:26px}.unlock{border-left:4px solid #d5b980;background:#d5b9800a}.unlock h2{color:#e0c58a}footer{border-top:1px solid #46635f;margin-top:30px;padding-top:16px;font-size:22px;color:#8aaea5;letter-spacing:2px}
</style></head><body><main>
<header><div class="portrait">{% if portrait %}<img src="{{ portrait }}" alt="{{ detail['发起人']|e }}">{% else %}策略{% endif %}</div><div><div class="activity">{{ detail['卫戍协议']|e }}</div><h1>{{ detail['名称']|e }}</h1>{% if detail['发起人'] %}<div class="owner">发起人 · {{ detail['发起人']|e }}</div>{% endif %}</div><div class="kind">策略</div></header>
{% if overview %}<section class="section"><h2>策略说明</h2><div class="text">{{ overview|e }}</div></section>{% endif %}
{% for skill in display_skills %}<section class="section"><div class="skill-head"><span class="tag {% if skill['类型']=='主动' %}active{% endif %}">{{ skill['类型']|e }}</span>{% if '费用' in skill %}<span class="meta">消耗 {{ skill['费用'] }}</span>{% endif %}{% if skill.get('使用限制') %}<span class="meta">{{ skill['使用限制']|e }}</span>{% endif %}</div><div class="text">{{ skill['描述']|e }}</div></section>{% endfor %}
<section class="section unlock"><h2>解锁条件</h2><div class="text">{{ detail['解锁条件']|e }}</div></section><footer>卫戍协议 · 策略资料</footer>
</main></body></html>
